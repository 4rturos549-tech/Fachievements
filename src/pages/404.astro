---
import Layout from '../layouts/Layout.astro';
---
<Layout title="404 — No encontrado | Fachievements" backHref="/" backLabel="Inicio">
  <main style="max-width:1080px; margin:0 auto; padding:6rem 1.5rem; text-align:center;">
    <p style="font-family:'DM Mono',monospace; font-size:0.7rem; letter-spacing:0.22em; color:#f5a623; text-transform:uppercase; margin-bottom:1rem;">Error 404</p>
    <h1 style="font-family:'Bebas Neue',sans-serif; font-size:clamp(3rem,8vw,5rem); letter-spacing:0.04em; color:#f0ece4; margin-bottom:1rem;">Página no encontrada</h1>
    <p style="color:#555; font-size:0.95rem; margin-bottom:2rem;">La ruta que buscas no existe o se ha movido.</p>
    <a href="/" style="display:inline-block; background:#f5a623; color:#000; font-weight:700; font-size:0.78rem; letter-spacing:0.08em; text-transform:uppercase; padding:0.75rem 1.5rem; border-radius:7px; text-decoration:none;">Volver al inicio</a>
  </main>
</Layout>
