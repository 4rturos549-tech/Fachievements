---
import Layout from '../layouts/Layout.astro';
import SearchBar from '../components/SearchBar.tsx';
import { getFeaturedGames } from '../lib/igdb';
import { createServerSupabase } from '../lib/supabase';
import type { FeaturedGame } from '../lib/types';

let featured: FeaturedGame[] = [];
try {
  featured = await getFeaturedGames();
} catch (e) {
  console.error('[index] featured:', e);
}

let stats = { guides: 0, completed: 0 };
try {
  const supabase = createServerSupabase();
  const [{ count: guidesCount }, { count: stepsCount }] = await Promise.all([
    supabase.from('game_guides').select('*', { count: 'exact', head: true }),
    supabase.from('completed_steps').select('*', { count: 'exact', head: true }),
  ]);
  stats = { guides: guidesCount ?? 0, completed: stepsCount ?? 0 };
} catch (e) {
  console.error('[index] stats:', e);
}

// 12 carátulas para el fondo (las mismas que destacados, sin requests extra)
const bgCovers = featured.slice(0, 12).map(g => g.coverUrl).filter(Boolean) as string[];
---

<Layout
  title="Fachievements — Guías de Trofeos y Logros"
  description="Busca cualquier juego, sigue la guía paso a paso y consigue todos los trofeos y logros sin perder ninguno."
>
  {bgCovers.length > 0 && (
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-bg-grid">
        {bgCovers.map(url => (
          <div class="hero-bg-cell" style={`background-image:url(${url})`}></div>
        ))}
      </div>
      <div class="hero-bg-fade"></div>
    </div>
  )}

  <main style="max-width:1080px; margin:0 auto; padding:3.5rem 1.5rem 6rem; position:relative; z-index:2;">

    <header style="margin-bottom:3.5rem;">
      <p style="font-family:'DM Mono',monospace; font-size:0.68rem; letter-spacing:0.22em; color:#f5a623; text-transform:uppercase; margin-bottom:0.85rem; opacity:0.8;">Base de datos global · IGDB</p>
      <h1 style="font-family:'Bebas Neue',sans-serif; font-size:clamp(3rem,8vw,5.5rem); letter-spacing:0.04em; line-height:0.92; color:#f0ece4; margin-bottom:1.25rem;">
        Consigue<br/>
        <span class="hero-shine">el Platino.</span>
      </h1>
      <p style="font-size:1rem; color:#484848; font-weight:400; max-width:420px; line-height:1.65;">
        Busca cualquier juego, sigue la guía paso a paso y no pierdas ningún trofeo.
      </p>

      {(stats.guides > 0 || stats.completed > 0) && (
        <p class="hero-stats">
          <span class="stat-dot"></span>
          {stats.guides > 0 && <><strong>{stats.guides}</strong> guía{stats.guides === 1 ? '' : 's'} disponibles</>}
          {stats.guides > 0 && stats.completed > 0 && <span class="stat-sep">·</span>}
          {stats.completed > 0 && <><strong>{stats.completed.toLocaleString('es')}</strong> pasos completados por la comunidad</>}
        </p>
      )}
    </header>

    <SearchBar client:load />

    {featured.length > 0 && (
      <section style="margin-top:4rem;">
        <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1.5rem;">
          <span style="font-family:'DM Mono',monospace; font-size:0.65rem; letter-spacing:0.18em; color:#333; text-transform:uppercase;">Destacados</span>
          <div style="flex:1; height:1px; background:#1a1a1a;"></div>
          <span style="font-family:'DM Mono',monospace; font-size:0.6rem; letter-spacing:0.12em; color:#2a2a2a; text-transform:uppercase;">Top rated</span>
        </div>

        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(140px, 1fr)); gap:0.85rem;">
          {featured.map(game => (
            <a
              href={`/guias/${game.id}`}
              class="featured-card"
              style="position:relative; display:block; border-radius:8px; overflow:hidden; background:#0d0d0d; border:1px solid #1a1a1a; text-decoration:none; transition:border-color 0.2s, transform 0.2s, box-shadow 0.2s;"
            >
              <div style="aspect-ratio:3/4; overflow:hidden; background:#111;">
                <img src={game.coverUrl || 'https://placehold.co/300x400/0d0d0d/222?text=?'} alt={game.name} style="width:100%; height:100%; object-fit:cover;" loading="lazy" />
              </div>
              <div style="position:absolute; inset:0; background:linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.15) 60%, transparent 100%); padding:0.7rem; display:flex; flex-direction:column; justify-content:flex-end;">
                {game.rating && (
                  <span style="font-family:'DM Mono',monospace; font-size:0.6rem; color:#f5a623; margin-bottom:3px;">{game.rating}</span>
                )}
                <p style="color:#e8e4dc; font-size:0.75rem; font-weight:600; line-height:1.25; margin:0;">{game.name}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

  </main>
</Layout>

<style>
  .featured-card:hover { border-color: #7a4e0d !important; transform: translateY(-3px); box-shadow: 0 12px 32px rgba(0,0,0,0.6); }

  /* Fondo con grid de carátulas difuminadas */
  .hero-bg {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 80vh;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
  }
  .hero-bg-grid {
    position: absolute;
    inset: -10%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(3, 1fr);
    gap: 1.25rem;
    filter: blur(28px) saturate(0.85);
    opacity: 0.55;
    animation: bg-drift 60s ease-in-out infinite alternate;
  }
  .hero-bg-cell {
    background-size: cover;
    background-position: center;
    border-radius: 12px;
  }
  .hero-bg-fade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 30% 20%, rgba(245,166,35,0.08), transparent 55%),
      linear-gradient(to bottom, rgba(8,8,8,0.15) 0%, rgba(8,8,8,0.6) 55%, #080808 100%);
  }
  @keyframes bg-drift {
    from { transform: translate(-1%, -1%) scale(1); }
    to   { transform: translate(1%, 1.5%) scale(1.05); }
  }
  @media (max-width: 700px) {
    .hero-bg-grid { grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(4, 1fr); filter: blur(34px) saturate(0.85); opacity: 0.45; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-bg-grid { animation: none; }
  }

  /* Shimmer del título */
  .hero-shine {
    background: linear-gradient(90deg, #d4891a 0%, #f5a623 35%, #ffd27a 50%, #f5a623 65%, #d4891a 100%);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 4s ease-in-out infinite;
  }
  @keyframes shine {
    0%, 100% { background-position: 0% 50%; }
    50%      { background-position: 100% 50%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-shine { animation: none; }
  }

  /* Stats live */
  .hero-stats {
    margin-top: 1.5rem;
    font-family: 'DM Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: #555;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }
  .hero-stats strong { color: #f0ece4; font-weight: 600; }
  .hero-stats .stat-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 8px #4ade80;
    animation: pulse 2s ease-in-out infinite;
  }
  .hero-stats .stat-sep { color: #2a2a2a; }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.4; }
  }
</style>
