# Supabase (cliente — prefijo PUBLIC_ las expone al navegador)
PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Supabase (servidor — solo si quieres bypass de RLS para subir guías)
SUPABASE_SERVICE_ROLE_KEY=

# Twitch / IGDB (solo servidor, NO usar prefijo PUBLIC_)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Admin (solo servidor — protege el endpoint /api/admin/upload-guide)
ADMIN_PASSWORD=cambia-esta-contraseña-larga-y-aleatoria
